generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityProvider {
  password
  wechat_mini_program
  phone
}

enum ClientType {
  web
  wechat_mini_program
  admin
}

enum FileStatus {
  pending
  parsed
  failed
  classifying
  chunking
  embedding
  ready
}

enum PaperStatus {
  pending
  generating
  completed
  failed
  timeout
}

model User {
  id                  String     @id @default(uuid())
  displayName         String?
  avatarUrl           String?
  role                String     @default("user")
  membershipType      String     @default("free")
  membershipExpire    DateTime?
  inviteCodeUsed      String?
  remainingGenerations Int       @default(20)
  quotaResetAt        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  identities        UserIdentity[]
  uploadedFiles     UploadedFile[]
  generatedPapers   GeneratedPaper[]
  generationLogs    GenerationLog[]
  createdInviteCodes InviteCode[]  @relation("InviteCodeCreator")
  usedInviteCodes   InviteCode[]  @relation("InviteCodeUser")
}

model UserIdentity {
  id           String           @id @default(uuid())
  userId       String
  provider     IdentityProvider
  identifier   String
  passwordHash String?
  externalId   String?
  openid       String?
  unionid      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier])
  @@index([externalId])
  @@index([openid])
}

model UploadedFile {
  id                 String     @id @default(uuid())
  userId             String
  originalName       String
  mimeType           String
  size               Int
  path               String
  hash               String?    @unique
  storageProvider    String     @default("local")
  storageKey         String?
  parsedText         String?
  parsedAt           DateTime?
  status             FileStatus @default(pending)
  clientType         ClientType @default(web)
  category           String?
  categoryConfidence Float?
  chunkCount         Int        @default(0)
  totalChars         Int        @default(0)
  errorMessage       String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([userId])
}

model GeneratedPaper {
  id                  String      @id @default(uuid())
  userId              String
  documentIds         Json
  courseName          String
  paperTitle          String?
  paperJson           Json
  rawResponse         String?
  category            String?
  sourceChunks        Json?
  durationSeconds     Float?
  failReason          String?
  config              Json?
  qualityReport       Json?
  knowledgeSummary    Json?
  promptVersion       String?
  modelName           String?
  tokenUsage          Int?
  status              PaperStatus @default(pending)
  clientType          ClientType  @default(web)
  originalPaperId     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperQuestions PaperQuestion[]
  generationLogs GenerationLog[]
  originalPaper  GeneratedPaper? @relation("PaperRegeneration", fields: [originalPaperId], references: [id])
  regenerations  GeneratedPaper[] @relation("PaperRegeneration")

  @@index([userId])
}

model PaperQuestion {
  id              String   @id @default(uuid())
  paperId         String
  questionNo      Int
  questionType    String
  content         String
  options         Json?
  answer          String
  analysis        String?
  knowledgePoints Json?
  difficulty      String?
  score           Float?
  sourceChunkIds  Json?
  isCrossDoc      Boolean  @default(false)

  paper GeneratedPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
}

model DocumentChunk {
  id           String   @id @default(uuid())
  fileId       String
  chunkIndex   Int
  content      String   @db.Text
  charCount    Int
  tokenEstimate Int
  pageNumber   Int?
  sectionTitle String?
  chromaId     String?  @unique
  createdAt    DateTime @default(now())

  file UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model GenerationLog {
  id            String   @id @default(uuid())
  userId        String
  paperId       String?
  docIds        Json
  questionCount Int?
  tokenUsed     Int?
  durationMs    Int?
  retrievalK    Int?
  mode          String   @default("deep")
  status        String
  errorMessage  String?
  createdAt     DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper GeneratedPaper? @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([paperId])
}

model BillingLog {
  id            String   @id @default(uuid())
  userId        String
  type          String
  amount        Int
  paymentMethod String?
  transactionId String?  @unique
  status        String   @default("pending")
  metadata      Json?
  createdAt     DateTime @default(now())
}

model InviteCode {
  id             String    @id @default(uuid())
  code           String    @unique
  status         String    @default("unused")
  membershipType String
  createdBy      String
  createdAt      DateTime  @default(now())
  expireAt       DateTime
  usedBy         String?
  usedAt         DateTime?

  creator User  @relation("InviteCodeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  user    User? @relation("InviteCodeUser", fields: [usedBy], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@index([usedBy])
}

model MembershipHistory {
  id             String    @id @default(uuid())
  userId         String
  changeType     String
  membershipType String
  startDate      DateTime
  endDate        DateTime?
  triggeredBy    String
  inviteCodeId   String?
  createdAt      DateTime  @default(now())
}
