UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520
DEFAULT_USER_QUOTA=10

CORS_ORIGIN=http://localhost:5173

WECHAT_APP_ID=
WECHAT_APP_SECRET=

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
