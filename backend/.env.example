NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://easy_test:change_me@postgres:5432/easy_test
POSTGRES_USER=easy_test
POSTGRES_PASSWORD=change_me
POSTGRES_DB=easy_test

JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change_me_refresh_to_a_random_64_char_string
JWT_REFRESH_EXPIRES_IN=7d

DEEPSEEK_API_KEY=your_deepseek_api_key_here
